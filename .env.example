PORT=8787
CLIENT_ORIGIN=http://localhost:5173
# Web service only: VITE_API_BASE_URL=https://your-api.up.railway.app
# Web service only: VITE_SUPABASE_URL=https://your-project.supabase.co
# Web service only: VITE_SUPABASE_ANON_KEY=public-anon-key
STORAGE_PROVIDER=json
# PostgreSQL/Supabase production
# STORAGE_PROVIDER=postgres
# DATABASE_URL=postgresql://...
# DATABASE_SSL=true          # 严格 TLS 校验(推荐);公开 CA,或配合 DATABASE_CA 使用
# DATABASE_SSL=no-verify     # 仅加密、不校验证书(不推荐;仅自签名且无 CA 时显式使用)
# DATABASE_CA=/path/to/ca.pem  # 自定义 CA 证书路径(可选,配合 DATABASE_SSL=true)
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=15000
STORAGE_RETRY_ATTEMPTS=3
DATABASE_POOL_MAX=10
MODEL_PROVIDER=mock
# Set provider credentials only on the server. The UI never receives API keys.
# MODEL_API_URL=https://your-provider.example/v1/chat/completions
# MODEL_API_KEY=
# MODEL_NAME=your-model-name
# Per-provider overrides: MODEL_DEEPSEEK_API_KEY / MODEL_DEEPSEEK_NAME / MODEL_DEEPSEEK_API_URL
# Other providers use the same pattern, for example MODEL_OPENAI_API_KEY and MODEL_OPENAI_NAME.
# MODEL_TIMEOUT_MS=30000
# MODEL_SYSTEM_PROMPT=
# Authentication: keep off for local development, require for public deployment.
AUTH_MODE=off
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=server-safe-public-anon-key
# SUPABASE_JWT_SECRET=optional-legacy-jwt-secret
# Independent Memory Module service
# MEMORY_MODULE_PORT=8791
# MEMORY_MODULE_SERVICE_TOKEN=server-only-token
# MEMORY_MODULE_AUTO_MIGRATE=false
# MEMORY_MODULE_PGVECTOR_ENABLED=false
# MEMORY_MODULE_EMBEDDING_DIMENSIONS=1536
# MEMORY_MODULE_NATIVE_RETRIEVAL=false
# MEMORY_MODULE_REDIS_URL=redis://localhost:6379
# MEMORY_MODULE_CACHE_TTL_SECONDS=30
# MEMORY_EMBEDDING_URL=https://embedding-provider.example/v1
# MEMORY_EMBEDDING_API_KEY=server-only-token
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_EMBEDDING_TIMEOUT_MS=5000
# MEMORY_EMBEDDING_RETRY_ATTEMPTS=1
# MEMORY_EMBEDDING_VERSION=provider-model-v1
# MEMORY_EMBEDDING_RETENTION_POLICY=no-training-30d
# MEMORY_EMBEDDING_PROVIDER=http-embedding
# MEMORY_EXTRACTION_URL=https://model-provider.example/v1
# MEMORY_EXTRACTION_API_KEY=server-only-token
# MEMORY_EXTRACTION_MODEL=structured-memory-model
# MEMORY_EXTRACTION_TIMEOUT_MS=5000
# MEMORY_EXTRACTION_RETRY_ATTEMPTS=1
# MEMORY_EXTRACTION_VERSION=memory-extraction-v1
# MEMORY_EXTRACTION_RETENTION_POLICY=no-training-30d
# MEMORY_EXTRACTION_PROVIDER=http-extraction
# MEMORY_MODULE_WORKER_ENABLED=false
# MEMORY_MODULE_WORKER_ID=memory-worker-1
# MEMORY_MODULE_WORKER_POLL_MS=1000
# MEMORY_MODULE_WORKER_LEASE_MS=30000
# MEMORY_MODULE_WORKER_MAX_ATTEMPTS=5
# MEMORY_MODULE_SUPPORTED_OUTBOX_SCHEMA_VERSIONS=1
# MEMORY_MODULE_RETENTION_SWEEP_MS=60000
# MEMORY_MODULE_RETENTION_SWEEP_BATCH=10
# MEMORY_MODULE_RATE_LIMIT_MAX=120
# MEMORY_TENANT_ID=local-tenant
# MEMORY_AUTO_EXTRACT=false
# MEMORY_AUTO_PROFILE_UPDATE=false
# MEMORY_HYBRID_RETRIEVAL=false
# MEMORY_VECTOR_RETRIEVAL=false
# MEMORY_EPISODE_GROUPING=false
# MEMORY_PROACTIVE_MENTION=false
# MEMORY_MODULE_MENTION_COOLDOWN_MS=21600000

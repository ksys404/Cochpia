# Cochpia 环境变量示例
#
# 用法:cp .env.example .env 然后按下面标注填写。
#   【必填】生产必须显式设置            【建议】生产强烈建议
#   【可选】有代码默认值,不设也能跑      【仅本地/CI】验收与压测用,生产不要开
# 绝不要把真实密钥提交进仓库(.env 已在 .gitignore 中)。

# ───────────────────────── 基础 ─────────────────────────
PORT=8787
CLIENT_ORIGIN=http://localhost:5173          # 【必填】生产改成真实 HTTPS 前端域名(可逗号分隔多个)
NODE_ENV=development                         # 【必填】生产必须 production:生产守卫(拒绝 mock 模型、dev 路由 404、HSTS、关闭观测记录、关闭不可信 agent header)全部依赖它
APP_VERSION=0.1.0
API_RATE_LIMIT_MAX=120                       # 按客户端地址限流
# CSP=                                       # 【可选】覆盖默认 Content-Security-Policy

# ───────────────────────── 存储 ─────────────────────────
STORAGE_PROVIDER=json                        # 【必填】生产用 postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME   # postgres 时必填
# DATABASE_SSL=true                          # 【必填】生产必须 true / require / verify-full;启动时强制校验,不满足直接拒启
# DATABASE_CA=/path/to/prod-ca.pem           # 【可选】配合 DATABASE_SSL=true 使用自定义 CA
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=15000
DATABASE_POOL_MAX=10
STORAGE_RETRY_ATTEMPTS=3
# COCHPIA_DATA_DIR=./server/data             # 【可选】JSON 模式的状态目录
USER_STATE_CACHE_TTL_MS=30000                # 按用户状态的进程内缓存时长

# ───────────────────────── 认证 ─────────────────────────
AUTH_MODE=off                                # 【必填】生产用 required
# SUPABASE_URL=https://xxxx.supabase.co                 # required 时必填
# SUPABASE_JWT_SECRET=...                               # required 时必填(服务端校验 token)

# ───────────────────────── 前端(构建期变量,由 Vite 注入)─────────────────────────
# VITE_API_BASE_URL=                                    # 【可选】前端请求的 API 基地址;留空 = 同源
# VITE_SUPABASE_URL=https://xxxx.supabase.co            # 前端登录需要
# VITE_SUPABASE_ANON_KEY=...                            # 前端登录需要(anon key 可公开,不要放 service_role)

# ───────────────────────── 模型 ─────────────────────────
MODEL_PROVIDER=mock                          # 【必填】生产不允许 mock(代码会拒绝启动),例如 deepseek / openai / gemini
MODEL_NAME=
# MODEL_API_URL=https://api.example.com/v1
# MODEL_API_KEY=...
MODEL_TIMEOUT_MS=30000
# MODEL_SYSTEM_PROMPT=                       # 【可选】覆盖默认身份提示词
# MODEL_OPENAI_API_KEY=...                   # 走 openai 兼容协议时的备用键
# MODEL_OPENAI_NAME=
WORK_MODEL_PROVIDER=                         # 【可选】工作模式单独指定模型
WORK_MODEL_NAME=

# ───────────────────────── 聊天运行时 ─────────────────────────
CHAT_RUN_TIMEOUT_MS=120000                   # 一轮对话的总超时(到点标记 cancelled + abort)
CHAT_PREPARE_TIMEOUT_MS=30000                # 准备阶段看门狗:记忆/存储挂住时回 503,而不是静默悬挂
CHAT_TERMINATION_GRACE_MS=5000               # 超时后的兜底窗口:上游无视 abort 也要把 SSE 关掉
SSE_RUN_RETENTION_MS=300000
GROUP_AGENT_LIMIT=6
APPROVAL_TIMEOUT_MS=300000
APPROVAL_SESSION_TTL_MS=1800000
AGENT_CONCURRENCY_MAX=                             # 【可选】Agent 任务并发上限

# ───────────────────────── 记忆模块 ─────────────────────────
MEMORY_TENANT_ID=local-tenant                # 【必填】与库中已有数据的 tenantId 必须一致,否则记忆全部不可见
# MEMORY_MODULE_URL=                         # 【可选】走独立记忆服务时填
# MEMORY_MODULE_SERVICE_TOKEN=
MEMORY_ALLOW_UNTRUSTED_AGENT_HEADERS=false   # 仅在非生产可生效;生产务必保持 false
MEMORY_RECENCY_HALF_LIFE_DAYS=30             # 新近度半衰期(天)

# 功能开关(全部默认 false;开启前先看 docs/ 与对应测试)
MEMORY_AUTO_EXTRACT=false
MEMORY_AUTO_PROFILE_UPDATE=false
MEMORY_HYBRID_RETRIEVAL=false                # 词法 + 向量 RRF 融合
MEMORY_VECTOR_RETRIEVAL=false
MEMORY_IMPORTANCE_RANKING=false              # 把重要性与新近度接进检索排序(开启后 retrievalMode 会显示 +importance+recency)
MEMORY_EPISODE_GROUPING=false
MEMORY_PROACTIVE_MENTION=false

# 嵌入与抽取(上面开关依赖它们时再配)
# MEMORY_EMBEDDING_URL=
# MEMORY_EMBEDDING_MODEL=
# MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_TIMEOUT_MS=150
# MEMORY_MODULE_EMBEDDING_DIMENSIONS=1536
# MEMORY_EXTRACTION_URL=
# MEMORY_EXTRACTION_MODEL=
# MEMORY_EXTRACTION_API_KEY=
# MEMORY_RECOVERY_STATE=
# MEMORY_RECOVERY_LEDGER=

# ───────────────────────── 日历 / 主动唤醒 ─────────────────────────
UPCOMING_EVENT_DAYS=7                        # 「临近日程」注入对话上下文的窗口(天)
WAKEUP_ENABLED=false                         # 主动唤醒

# ───────────────────────── 外部 Agent 与工作区 ─────────────────────────
PI_ENABLED=false
CODEX_ENABLED=false
# CODEX_BIN=codex
CLAUDE_ENABLED=false
# CLAUDE_BIN=claude
# COCHPIA_WORKSPACE_ROOTS=/path/one,/path/two   # 【建议】Agent 任务需要额外目录时才配
TASK_SANDBOX_MAX_AGE_MS=86400000

# ───────────────────────── 音乐 ─────────────────────────
MUSIC_MODE=mock                              # mock / netease
# MUSIC_MCP_SERVER=
# MUSIC_MCP_COMMAND=
# MUSIC_MCP_ARGS=
# MUSIC_MCP_MPV=
# MUSIC_MCP_NETEASE_CLI=

# ───────────────────────── 小红书 MCP(可选集成)─────────────────────────
# XHS_MCP_URL=
# XHS_MCP_TIMEOUT_MS=
# XHS_EXPORT_DIR=

# ───────────────────────── 仅本地 / CI:验收与压测 ─────────────────────────
# 这些不要进生产环境。
# RUN_API_INTEGRATION=true                   # 打开后 server/isolation.test.js 与 server/regenerate.test.js 会真实调用 API(需服务在跑)
# COCHPIA_TEST_API=http://localhost:8787
# TEST_USER_A_EMAIL=
# TEST_USER_A_PASSWORD=
# TEST_USER_A_TOKEN=
# TEST_USER_B_EMAIL=
# TEST_USER_B_PASSWORD=
# TEST_USER_B_TOKEN=
# MEMORY_EVAL_CASES=
# MEMORY_EVAL_K=
# MEMORY_EVAL_RESULTS=
# MEMORY_EVAL_SPLIT=
# MEMORY_EVAL_SYNTHETIC_RESULTS=
# MEMORY_BENCHMARK_CONCURRENCY=
# MEMORY_BENCHMARK_DOCUMENTS=
# MEMORY_BENCHMARK_LIMIT=
# MEMORY_BENCHMARK_REQUESTS=
# MEMORY_BENCHMARK_TENANTS=
# MEMORY_BENCHMARK_USERS=
# MEMORY_MODULE_ACCEPTANCE_APPLY_SCHEMA=
# MEMORY_MODULE_ACCEPTANCE_PGVECTOR=
# MEMORY_MODULE_ACCEPTANCE_POOL_MAX=
# MEMORY_MODULE_ACCEPTANCE_REQUIRE_HNSW=
# MEMORY_MODULE_BENCHMARK_APPLY_SCHEMA=
# MEMORY_MODULE_BENCHMARK_DB_ENABLED=
# MEMORY_MODULE_BENCHMARK_PGVECTOR=
# MEMORY_MODULE_BENCHMARK_POOL_MAX=
# MEMORY_MODULE_BENCHMARK_REBUILD_HNSW=
# MEMORY_MODULE_SMOKE_APPLY_SCHEMA=
# MEMORY_MODULE_SDK_AGENT_ID=
# MEMORY_MODULE_SDK_TENANT_ID=
# MEMORY_MODULE_SDK_USER_ID=
